# Public canonical URL of the deployed site. Used for og/twitter meta and JSON-LD.
VITE_SITE_URL=https://quale-conviene.example

# Cloudflare Web Analytics token (privacy-first). Leave unset to disable.
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Buy Me a Coffee username. Leave unset to hide the donation button.
VITE_BMC_HANDLE=

# Set to "true" to render ad slots. Defaults to disabled.
VITE_ADS_ENABLED=false
